    dcterms:title "Records – Administrative Metadaten"@de ;
    dcterms:description "Vokabularreferenz für administrative Records, Provenienz und Qualitätsangaben sowie eine optionale IRI-Verknüpfung zum Item als konservative SHACL-Startregel. Fachlicher Arbeitsentwurf; die API lädt weiterhin ausschließlich die separate Minimalpolicy records.ttl."@de ;
    dcterms:hasVersion "0.1.0" ;
    adms:status "Arbeitsentwurf"@de ;
    dcterms:publisher <https://www.deutsche-digitale-bibliothek.de/> ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/de> ;
    dcterms:source "DDB-Metadatenkonzept, Version 0.1, 06.11.2026 (lokale Arbeitsgrundlage)"@de ;
