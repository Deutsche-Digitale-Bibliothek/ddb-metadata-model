    dcterms:title "Catalog – Katalog und Datendienste"@de ;
    dcterms:description "Vokabularreferenz für Katalog und Datendienste auf Basis von DCAT 3. Die konservative SHACL-Startregel prüft nur vorhandene Datensetverweise; sie verlangt kein Datenset. Fachlicher Arbeitsentwurf, keine aktive API-Policy."@de ;
    dcterms:hasVersion "0.1.0" ;
    adms:status "Arbeitsentwurf"@de ;
    dcterms:publisher <https://www.deutsche-digitale-bibliothek.de/> ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/de> ;
    dcterms:source "DDB-Metadatenkonzept, Version 0.1, 06.11.2026 (lokale Arbeitsgrundlage)"@de ;
